<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- 启动窗口跟随系统深浅色（设计规范_v1 §11.4，G-14）：浅色用 Light 父主题 + 浅色 window_background；
         深色版本在 values-night/themes.xml。Compose 里的主题再按 App 设置覆盖。 -->
    <style name="Theme.ModbusMobile" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">@color/window_background</item>
        <item name="android:navigationBarColor">@color/window_background</item>
        <item name="android:windowBackground">@color/window_background</item>
    </style>
</resources>
