<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 上位机模式（Corn Modbus）。Application / 启动 Activity 由 Corn Bench :app 提供。 -->
    <uses-feature
        android:name="android.hardware.usb.host"
        android:required="false" />

    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application>
        <!-- Corn Modbus · by xingyingyuzhui · PolyForm Noncommercial 1.0.0 -->
        <meta-data
            android:name="io.github.xingyingyuzhui.modbus.author"
            android:value="xingyingyuzhui" />
        <meta-data
            android:name="io.github.xingyingyuzhui.modbus.repo"
            android:value="https://github.com/xingyingyuzhui/corn-modbus" />

        <!-- 日志“分享”：把导出文件放在 cache/exports 下，经 FileProvider 给接收方临时读权限。 -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.exports"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <service
            android:name=".service.SessionService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice" />
    </application>
</manifest>
